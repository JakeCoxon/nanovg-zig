{
  "name": "nanovg",
  "version": "0.0.1",
  "description": "NanoVG graphics library using WebAssembly",
  "type": "module",
  "main": "dist/nanovg.umd.js",
  "module": "dist/nanovg.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nanovg.es.js",
      "require": "./dist/nanovg.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.js",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "nanovg",
    "zig",
    "webassembly",
    "graphics",
    "2d",
    "vector",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
